{
  "name": "gramma",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup-db": "bun run migrate && bun run seed",
    "reset-db": "supabase db reset && bun run setup-db",
    "test": "vitest run --exclude '**/tests/integration/**'",
    "test:integration": "vitest run integration",
    "test:e2e": "bunx playwright test",
    "check": "biome check .",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "knip": "knip",
    "migrate": "drizzle-kit migrate",
    "generate-migration": "drizzle-kit generate",
    "seed": "bun packages/db/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "immutable": "^5.1.9",
      "drizzle-orm": "^0.45.2",
      "uuid": "^14.0.1",
      "@formkit/tempo": "^0.1.2",
      "dotenv": "^17.4.2",
      "postgres": "^3.4.7",
      "neverthrow": "^8.2.0"
    }
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@supabase/supabase-js": "^2.99.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "immutable": "catalog:",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "solid-js": "^1.9.9",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.18.12",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "supabase": "^2.112.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
