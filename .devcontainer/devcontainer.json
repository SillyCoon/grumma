{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /mnt/mise-data && mise install --locked && pnpm install && supabase start",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "astro-build.astro-vscode",
        "hverlin.mise-vscode"
      ]
    }
  },
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/home/vscode/.config/git/config"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/mnt/mise-data/shims"
  },
  "mounts": [
    {
      "source": "mise-data-volume",
      "target": "/mnt/mise-data",
      "type": "volume"
    }
  ]
}
