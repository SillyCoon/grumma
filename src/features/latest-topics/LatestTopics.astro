---
import { Card, CardHeader, CardTitle, CardContent } from "packages/ui/card";
import { FaSolidExternalLinkAlt } from "solid-icons/fa";
import { contextFromAstro } from "~/libs/context";
import { actions } from "astro:actions";

const { user } = contextFromAstro(Astro);

if (user.role === "guest") {
  return null;
}

const latestTopics = await Astro.callAction(actions.getLatestTopics, null);

if (!latestTopics.data) {
  return null;
}
---

<Card class="col-span-1 lg:col-span-3">
  <CardHeader class="flex flex-row justify-between">
    <CardTitle>Latest discussions</CardTitle>
    <a
      class="flex items-center gap-1 text-secondary hover:underline"
      href="https://grumma.discourse.group"
      target="_blank">Community <FaSolidExternalLinkAlt size={14} /></a
    >
  </CardHeader>
  <CardContent class="flex flex-row flex-wrap">
    {
      latestTopics.data.map((topic) => (
        <a
          href={topic.link}
          target="_blank"
          class="block py-2 px-3 rounded-md hover:bg-secondary/10 active:bg-secondary/20 transition-colors basis-full lg:basis-1/3"
        >
          <h3 class="text-sm font-medium">{topic.title}</h3>
          <p class="text-xs text-secondary">
            <span>{topic.categoryName}</span>
            <span class="mx-1">•</span>
            <span>
              {Intl.DateTimeFormat("en-US", { dateStyle: "medium" }).format(
                new Date(topic.lastPostedAt),
              )}
            </span>
          </p>
        </a>
      ))
    }
  </CardContent>
</Card>
