{
  "name": "gramma",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup-db": "bun run migrate && bun run seed",
    "reset-db": "supabase db reset && bun run setup-db",
    "dev": "astro dev",
    "test": "vitest run --exclude '**/tests/integration/**'",
    "test:integration": "vitest run integration",
    "test:e2e": "bunx playwright test",
    "start": "astro dev",
    "type-check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "knip": "knip",
    "upgrade-astro": "bunx @astrojs/upgrade",
    "migrate": "drizzle-kit migrate",
    "generate-migration": "drizzle-kit generate",
    "seed": "bun libs/db/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/solid-js": "7.0.2",
    "@astrojs/ts-plugin": "1.10.10",
    "@formkit/drag-and-drop": "^0.6.1",
    "@google-cloud/pino-logging-gcp-config": "^1.3.5",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/autofocus": "^0.1.4",
    "@solid-primitives/refs": "^1.1.2",
    "@solid-primitives/storage": "^4.3.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "astro": "7.1.1",
    "astro-loading-indicator": "^0.8.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "discourse-sdk": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "feedback": "workspace:*",
    "grammar-sdk": "workspace:*",
    "immutable": "^5.1.9",
    "intro.js": "^8.3.2",
    "neverthrow": "^8.2.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "resend": "^4.8.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.9",
    "solid-sonner": "^0.2.8",
    "solid-toast": "^0.5.0",
    "solid-utils": "workspace:*",
    "space-repetition": "workspace:*",
    "tailwindcss-animate": "^1.0.7",
    "ui": "workspace:*",
    "utils": "workspace:*",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.5.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.18.12",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "supabase": "^2.112.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
