---
import { actions } from "astro:actions";
import { NotificationBadge } from "ui/notification-badge";

const notifications = Astro.locals.user
  ? await Astro.callAction(actions.getNotifications, undefined)
  : null;
---

<div class="flex flex-col p-2">
  {
    !notifications?.data?.length ? (
      <p class="text-sm text-white">No notifications</p>
    ) : (
      notifications.data?.map((notification) => (
        <div>
          <a
            href={notification.link}
            target="_blank"
            class="flex relative items-start gap-2 rounded-md p-2 lg:hover:bg-secondary/20 lg:hover:shadow-md cursor-pointer"
          >
            <div class="flex-1">
              <p class="text-sm text-white font-bold ">{notification.title}</p>
              <p class="text-xs text-gray-100">
                {new Intl.DateTimeFormat(undefined, {
                  dateStyle: "medium",
                }).format(new Date(notification.createdAt))}
              </p>
            </div>
            {!notification.read && (
              <NotificationBadge size="sm" placement="center-right" />
            )}
          </a>
        </div>
      ))
    )
  }
</div>
