---
interface Props {
  action: string;
  method: string;
}

---

<form
  data-no-enter-submit
  action={Astro.props.action}
  method={Astro.props.method}
>
  <slot />
</form>

<script>
  let forms = document.querySelectorAll<HTMLFormElement>(
    "form[data-no-enter-submit]",
  );

  Array.from(forms).forEach((form) => {
    form?.addEventListener("keydown", (ev) => {
      const target = ev.target as HTMLElement | null;
      const isTextArea = target instanceof HTMLTextAreaElement;
      const isContentEditable = target?.isContentEditable === true;
      if (
        "key" in ev &&
        ev.key === "Enter" &&
        !isTextArea &&
        !isContentEditable
      ) {
        ev.preventDefault();
      }
    });
  });
</script>
