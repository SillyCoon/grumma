{
  "name": "gramma",
  "type": "module",
  "version": "0.0.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "setup-db": "bun run migrate && bun run seed",
    "reset-db": "supabase db reset && bun run setup-db",
    "test": "vitest run --exclude '**/tests/integration/**'",
    "test:integration": "vitest run integration",
    "test:e2e": "bunx playwright test",
    "check": "biome check .",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "knip": "knip",
    "migrate": "drizzle-kit migrate",
    "generate-migration": "drizzle-kit generate",
    "seed": "bun packages/db/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/node": "^22.18.12",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "supabase": "^2.112.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
