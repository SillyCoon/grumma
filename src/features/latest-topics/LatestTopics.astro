---
import { Card, CardContent, CardHeader, CardTitle } from "packages/ui/card";
import LatestTopicsContent from "./LatestTopicsContent.astro";
import LatestTopicsSkeleton from "./LatestTopicsSkeleton.astro";
import { FaSolidExternalLinkAlt } from "solid-icons/fa";
---

<Card class="col-span-1 lg:col-span-2">
  <CardHeader class="flex flex-row justify-between">
    <CardTitle>Latest discussions</CardTitle>
    <a
      class="flex items-center gap-1 text-secondary hover:underline"
      href="https://grumma.discourse.group"
      target="_blank">Community <FaSolidExternalLinkAlt size={14} /></a
    >
  </CardHeader>
  <CardContent class="grid gap-2 lg:grid-cols-3 grid-cols-1">
    <LatestTopicsContent server:defer>
      <LatestTopicsSkeleton slot="fallback" />
    </LatestTopicsContent>
  </CardContent>
</Card>
