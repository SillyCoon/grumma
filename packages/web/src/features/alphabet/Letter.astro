---
import type { Letter } from "./lib";

type Props = Letter;

const { ru, hint, image } = Astro.props;
---

<div class="letter">
  <div>{ru}</div>
  <div>{hint}</div>
  {image && <img src={image} alt={ru} />}
</div>

<style>
  .letter {
    &:hover {
      background-color: hsl(var(--primary) / 0.6);
    }
    transition: background-color 0.3s ease;
    border: 1px solid hsl(var(--primary));
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
  }
</style>
